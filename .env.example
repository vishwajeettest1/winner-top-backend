PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/streamearn?replicaSet=rs0
JWT_USER_SECRET=replace_with_at_least_32_random_characters_user
JWT_ADMIN_SECRET=replace_with_a_different_32_character_admin_secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Ad networks
ADMOB_SSV_SHARED_SECRET=replace_me
UNITY_ADS_SSV_SHARED_SECRET=replace_me

# Payout economics (as decimal fractions of verified gross revenue)
USER_REVENUE_SHARE=0.5
REFERRER_REVENUE_SHARE=0.1

# Withdrawal rules
MIN_WITHDRAWAL_AMOUNT=50
WITHDRAWAL_REVIEW_DAYS=3

# Daily reward cap
DAILY_REWARD_VIDEO_CAP=10

# OTP phone parsing defaults to India for national-format mobile numbers.
PHONE_DEFAULT_REGION=IN

# Email OTP delivery (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
OTP_FROM_EMAIL=no-reply@example.com

# SMS OTP delivery (Twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+10000000000