PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/streamearn
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Ad networks
ADMOB_SSV_SHARED_SECRET=replace_me
UNITY_ADS_SSV_SHARED_SECRET=replace_me

# Payout economics (as decimal fractions of verified gross revenue)
USER_REVENUE_SHARE=0.5
REFERRER_REVENUE_SHARE=0.1

# Withdrawal rules
MIN_WITHDRAWAL_AMOUNT=10
WITHDRAWAL_REVIEW_DAYS=3

# Daily reward cap
DAILY_REWARD_VIDEO_CAP=10

# OTP / notifications
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
SENDGRID_API_KEY=your_sendgrid_api_key